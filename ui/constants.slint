import { StyleMetrics } from "std-widgets.slint";

export global Icons {
    out property <image> arrow-up: @image-url("assets/arrow-up.png");
    out property <image> arrow-left: @image-url("assets/arrow-left.png");
    out property <image> arrow-right: @image-url("assets/arrow-right.png");
    out property <image> chevron-left: @image-url("assets/chevron-left.png");
    out property <image> arrow-down: @image-url("assets/arrow-down.png");
    out property <image> arrow-circle-o-left: @image-url("assets/arrow-circle-o-left.png");
    out property <image> globe: @image-url("assets/globe.png");
    out property <image> expand-more: @image-url("assets/expand-more.png");
    out property <image> backspace: @image-url("assets/backspace.png");
    out property <image> bed: @image-url("assets/bed.png");
    out property <image> check: @image-url("assets/check.png");
    out property <image> close: @image-url("assets/close.png");
    out property <image> console: @image-url("assets/console.png");
    out property <image> device_temperature: @image-url("assets/device_temperature.png");
    out property <image> eject: @image-url("assets/eject.png");
    out property <image> emergency_stop: @image-url("assets/emergency.png");
    out property <image> extruder: @image-url("assets/extruder.png");
    out property <image> fan: @image-url("assets/fan.png");
    out property <image> file: @image-url("assets/file.png");
    out property <image> move: @image-url("assets/move.png");
    out property <image> print: @image-url("assets/print.png");
    out property <image> quick_action: @image-url("assets/quickaction.png");
    out property <image> settings: @image-url("assets/settings.png");
    out property <image> temperature: @image-url("assets/temperature.png");
    out property <image> action: @image-url("assets/action.png");
    out property <image> power-device: @image-url("assets/power_device.png");
    out property <image> height: @image-url("assets/height.png");
    out property <image> layer-height: @image-url("assets/layer_height.png");
