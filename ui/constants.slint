export global Constants {
    out property <int> font-weight-bold: 900;
    out property <int> font-weight-thin: 300;

    out property <length> font-size-sm: 10px;
    out property <length> font-size-md: 16px;
    out property <length> font-size-lg: 20px;

    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 16px;
    out property <length> radius-xl: 24px;

    out property <length> padding-extra: StyleMetrics.layout-padding * 1.5;
    out property <length> padding: StyleMetrics.layout-padding;
    out property <length> padding-half: StyleMetrics.layout-padding / 2;
    out property <length> padding-quarter: StyleMetrics.layout-padding / 4;

    out property <length> spacing: StyleMetrics.layout-spacing;
    out property <length> spacing-half: StyleMetrics.layout-spacing / 2;

    out property <length> thumbnail-size: 32px;
    out property <length> list-entry-height: 32px;
}